{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAP GUI transaction profile",
  "type": "object",
  "required": ["code", "module", "tier", "description", "keywords", "fields", "execute", "result_grid", "max_rows"],
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "module": {"type": "string", "minLength": 2},
    "tier": {"type": "string", "enum": ["display", "report", "write"]},
    "description": {"type": "string", "minLength": 1},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "position", "type", "required"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "position": {"type": "string", "enum": ["from", "to", "value"]},
          "type": {"type": "string", "enum": ["date", "number", "text"]},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "execute": {"type": "string", "pattern": "^(vkey_[0-9]+|press_[A-Za-z0-9_]+)$"},
    "result_grid": {"type": "string", "enum": ["grid"]},
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 500}
  },
  "additionalProperties": false
}
